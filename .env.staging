ENV_NAME=staging
DEBUG_MODE=true

# Auth Service
AUTH_HOST=staging.auth.collab.com
AUTH_PORT=443

# Chat Service
CHAT_HOST=staging.chat.collab.com
CHAT_PORT=443

# File Service
FILE_HOST=staging.file.collab.com
FILE_PORT=443

# Notification Service
NOTIFICATION_HOST=staging.notification.collab.com
NOTIFICATION_PORT=443

# API Configuration
API_TIMEOUT=30
CONNECTION_TIMEOUT=30
USE_SSL=true
